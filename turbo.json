{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "NODE_ENV",
    "ENVIRONMENT"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "API_URL"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "API_URL"
      ]
    },
    "lint": {},
    "test": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "DATABASE_URL",
        "REDIS_URL",
        "AUTH_SECRET",
        "ALERT_WEBHOOK_URL"
      ],
      "cache": false
    }
  }
}
