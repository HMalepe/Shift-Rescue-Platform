# Locum Planner — copy to .env and fill in. NEVER commit a filled-in .env.
#
# §10 (POPIA) and §12.1: this file names every secret the system needs, so a
# reviewer can see the blast radius of a leak at a glance. Values here are
# placeholders only.

# ---------------------------------------------------------------------------
# Database — Postgres 16 + PostGIS 3.4 (versions pinned; see docker-compose.yml)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://locum:locum_local_dev@localhost:5432/locum_planner_dev

# ---------------------------------------------------------------------------
# Redis — BullMQ queues (quiet-hours, dunning, notification fan-out) + rate limits
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Rotating this invalidates every session. Generate: openssl rand -hex 32
AUTH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# ---------------------------------------------------------------------------
# Twilio WhatsApp (§11)
# ---------------------------------------------------------------------------
# §11.1: a SEPARATE sender from the existing booking-agent number. Reusing it
# conflates conversation context and makes per-product analytics impossible.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+27000000000
# Used to validate the X-Twilio-Signature header on inbound webhooks.
TWILIO_WEBHOOK_SECRET=
# §11.6 soft daily spend cap — alerts, does not hard-block.
WHATSAPP_DAILY_SPEND_CAP_CENTS=50000

# ---------------------------------------------------------------------------
# Payments (§2, §10.0)
# ---------------------------------------------------------------------------
# SUBSCRIPTION COLLECTION ONLY. The platform never touches locum wages —
# see §10.0. There is deliberately no payout credential here.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
#
# Sandbox vs live is NOT a boolean here. It used to be documented as
# PAYFAST_SANDBOX=true, but nothing ever read that variable, and the
# adhoc-charge API host and the hosted-checkout host are not necessarily the
# same subdomain — encoding a guessed sandbox hostname behind a boolean would
# be worse than requiring both to be set explicitly from whatever Payfast's
# own sandbox account dashboard actually shows. Leave both unset to use
# production defaults (api.payfast.co.za and payfast.co.za/eng/process).
PAYFAST_BASE_URL=
PAYFAST_PROCESS_URL=
# Overrides the host apps/api posts to for ITN postback-validate. Same
# reasoning as above — left unset to use the production default
# (www.payfast.co.za) rather than guessing a sandbox hostname.
PAYFAST_ITN_HOST=
#
# Where Payfast redirects the manager's BROWSER after checkout — the Vercel
# dashboard, NOT this API. PUBLIC_BASE_URL (apps/api's own) is what Payfast
# calls server-to-server for the ITN; conflating the two sends a paying
# manager's browser to a bare JSON API instead of back to the dashboard.
DASHBOARD_BASE_URL=http://localhost:3001
# §2's flat monthly fee, in cents. No figure is fixed in the product spec —
# R899 is a placeholder used throughout this codebase's tests, not a pricing
# decision anyone has actually made.
SUBSCRIPTION_MONTHLY_CENTS=89900

# ---------------------------------------------------------------------------
# Document storage (§12.1)
# ---------------------------------------------------------------------------
# SAPC certificates, payslips, employment letters. Retrieval is by signed URL
# that EXPIRES — never a public bucket.
#
# S3_BUCKET, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY and S3_SSE_MODE are
# required TOGETHER. Set some and not others and the API falls back to the
# in-memory store, which would look like a working upload feature that loses
# every document on restart.
#
# Two providers are supported:
#
#   AWS S3 (infra/, the future scale-out path)
#     S3_SSE_MODE=aws-kms
#     S3_KMS_KEY_ID=<arn>          — required in this mode; S3DocumentStorage
#                                     refuses to construct without it. These
#                                     objects are POPIA special personal
#                                     information (§10).
#     S3_REGION=af-south-1
#     (leave S3_ENDPOINT unset)
#
#   Cloudflare R2 (the Railway MVP path — no AWS account needed)
#     S3_SSE_MODE=provider-managed  — R2 encrypts every object at rest under a
#                                     key it manages itself; there is no
#                                     customer KMS key to send.
#     S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#     S3_REGION=auto                — R2's own required value
#     AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are the R2 API token pair
#
# S3_SSE_MODE has no default on purpose. An unset value falls back to the
# in-memory stub rather than guessing a mode.
S3_BUCKET=
S3_REGION=af-south-1
S3_SSE_MODE=
S3_KMS_KEY_ID=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SIGNED_URL_TTL_SECONDS=300

# Malware scanning (§12.1). Uploads are scanned BEFORE storage, and a scanner
# that cannot be reached FAILS the upload rather than storing an unexamined
# file — there is no "unknown" verdict on purpose. Unset means the EICAR-only
# stub, which production refuses to boot with.
CLAMD_HOST=
CLAMD_PORT=3310

# ---------------------------------------------------------------------------
# Observability (§12.2)
# ---------------------------------------------------------------------------
SENTRY_DSN=
ENVIRONMENT=local
