# Locum Planner — copy to .env and fill in. NEVER commit a filled-in .env.
#
# §10 (POPIA) and §12.1: this file names every secret the system needs, so a
# reviewer can see the blast radius of a leak at a glance. Values here are
# placeholders only.
#
# Every name below is checked against the actual Zod schemas — apps/api/src/
# config.ts and apps/worker/src/config.ts — rather than assumed. The two
# services do NOT always agree on a name for the same concept (see the Twilio
# section), which is a real inconsistency in the codebase, not a typo here;
# each variable below says which service(s) actually read it. Railway's
# variable auto-detect reads this file, so a wrong name here silently feeds a
# wrong name into that UI too.

# ---------------------------------------------------------------------------
# Database — Postgres 16 + PostGIS 3.4 (versions pinned; see docker-compose.yml)
# Read by: api, worker
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://locum:locum_local_dev@localhost:5432/locum_planner_dev
DATABASE_MAX_CONNECTIONS=

# ---------------------------------------------------------------------------
# Redis — BullMQ queues (quiet-hours, dunning, notification fan-out)
# Read by: worker ONLY. apps/api never touches Redis — do not set this on
# the api service, it is simply ignored there.
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Auth
# Read by: api. Access/refresh token lifetimes are NOT environment-configurable
# — they are hardcoded in packages/core/src/auth/service.ts
# (DEFAULT_AUTH_CONFIG: 15m / 30d) — so there is deliberately no
# ACCESS_TOKEN_TTL / REFRESH_TOKEN_TTL variable to set here.
# ---------------------------------------------------------------------------
# Rotating this invalidates every session. Generate: openssl rand -hex 32
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Networking
# Read by: api (both), worker (ALERT_WEBHOOK_URL/RELEASE only)
# ---------------------------------------------------------------------------
NODE_ENV=development
ENVIRONMENT=local
# Twilio signs the FULL request URL for webhook verification — must be the
# exact public https origin, no trailing slash.
PUBLIC_BASE_URL=http://localhost:3000
# Where Payfast redirects the manager's BROWSER after checkout — the Vercel
# dashboard, NOT this API.
DASHBOARD_BASE_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Twilio WhatsApp (§11)
# ---------------------------------------------------------------------------
#
# This product REUSES an existing WhatsApp Business sender that already runs
# a different bot on the same Twilio account, rather than provisioning a new
# one as §11.1 originally called for. Deliberate, not an oversight — see
# docs/PRODUCT_TECH_SPEC.md's addendum on this decision for the full
# reasoning. The short version: the sender is already Meta-approved on this
# account, so there is no new-sender registration or display-name approval to
# wait on — only new templates for Locum Planner's own message types, which
# need Meta approval regardless of whether the sender is new or shared.
#
# Locum Planner is SEND-ONLY on this number. It never receives inbound
# WhatsApp messages — the other bot's inbound webhook is untouched by this
# integration, and Locum Planner has no code path that needs one. Delivery
# status still flows to Locum Planner's own webhook below
# (TWILIO_STATUS_CALLBACK_URL), because Twilio sets that per outbound
# message, not per sender — it does not collide with the other bot's inbound
# webhook configuration.
#
# Shared name, both services — same Account SID/Auth Token as the existing
# bot, since it's the same Twilio account:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# §11.2 — template name to Twilio Content SID, as JSON. The SIDs do not exist
# until Meta approves each template (§15, externally blocked).
TWILIO_CONTENT_SIDS={}
#
# TWILIO_WHATSAPP_FROM is canonical — both services read it, and it's the
# only name that shows up if you print a loaded config. TWILIO_FROM_NUMBER
# is still accepted on both services too, as a legacy alias (apps/api used to
# require that name specifically) — set either one and it resolves to the
# same field on both api and worker. Prefer TWILIO_WHATSAPP_FROM going
# forward; there is no reason to set both.
TWILIO_WHATSAPP_FROM=whatsapp:+27624760899
#
# worker only — where Twilio posts delivery-status callbacks TO the worker.
# apps/api computes its own from PUBLIC_BASE_URL instead and has no such
# variable.
TWILIO_STATUS_CALLBACK_URL=
#
# There is no TWILIO_WEBHOOK_SECRET variable. Inbound webhook signature
# verification (X-Twilio-Signature) reuses TWILIO_AUTH_TOKEN above — Twilio
# signs with the same auth token, it does not issue a separate webhook secret.
#
# worker only — §11.6 soft daily spend cap in cents. Alerts, never blocks.
# apps/api does not read this at all.
WHATSAPP_DAILY_SPEND_CAP_CENTS=50000

# ---------------------------------------------------------------------------
# Payments (§2, §10.0)
# ---------------------------------------------------------------------------
# SUBSCRIPTION COLLECTION ONLY. The platform never touches locum wages —
# see §10.0. There is deliberately no payout credential here.
# Shared name, both services:
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
#
# Sandbox vs live is NOT a boolean here. It used to be documented as
# PAYFAST_SANDBOX=true, but nothing ever read that variable, and the
# adhoc-charge API host and the hosted-checkout host are not necessarily the
# same subdomain — encoding a guessed sandbox hostname behind a boolean would
# be worse than requiring both to be set explicitly from whatever Payfast's
# own sandbox account dashboard actually shows. Leave unset to use production
# defaults (api.payfast.co.za and payfast.co.za/eng/process).
#
# worker only — overrides the adhoc-charge API host (dunning).
PAYFAST_BASE_URL=
# api only — the hosted-checkout page the manager's browser is redirected to.
PAYFAST_PROCESS_URL=
# api only — ITN postback-validate host override.
PAYFAST_ITN_HOST=
#
# §2's flat monthly fee, in cents. No figure is fixed in the product spec —
# R899 is a placeholder used throughout this codebase's tests, not a pricing
# decision anyone has actually made. api only.
SUBSCRIPTION_MONTHLY_CENTS=89900

# ---------------------------------------------------------------------------
# Document storage (§12.1)
# Read by: api ONLY. The worker never touches documents.
# ---------------------------------------------------------------------------
# SAPC certificates, payslips, employment letters. Retrieval is by signed URL
# that EXPIRES — never a public bucket.
#
# S3_BUCKET, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY and S3_SSE_MODE are
# required TOGETHER. Set some and not others and the API falls back to the
# in-memory store, which would look like a working upload feature that loses
# every document on restart.
#
# Two providers are supported:
#
#   AWS S3 (infra/, the future scale-out path)
#     S3_SSE_MODE=aws-kms
#     S3_KMS_KEY_ID=<arn>          — required in this mode; S3DocumentStorage
#                                     refuses to construct without it. These
#                                     objects are POPIA special personal
#                                     information (§10).
#     S3_REGION=af-south-1
#     (leave S3_ENDPOINT unset)
#
#   Cloudflare R2 (the Railway MVP path — no AWS account needed)
#     S3_SSE_MODE=provider-managed  — R2 encrypts every object at rest under a
#                                     key it manages itself; there is no
#                                     customer KMS key to send.
#     S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#     S3_REGION=auto                — R2's own required value
#     AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are the R2 API token pair
#
# S3_SSE_MODE has no default on purpose. An unset value falls back to the
# in-memory stub rather than guessing a mode.
S3_BUCKET=
S3_REGION=af-south-1
S3_SSE_MODE=
S3_KMS_KEY_ID=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Malware scanning (§12.1). api only. Uploads are scanned BEFORE storage, and
# a scanner that cannot be reached FAILS the upload rather than storing an
# unexamined file — there is no "unknown" verdict on purpose. Unset means the
# EICAR-only stub, which production refuses to boot with.
CLAMD_HOST=
CLAMD_PORT=3310

# ---------------------------------------------------------------------------
# Observability (§0.1/§12.2)
# Read by: api, worker (both watch ALERT_WEBHOOK_URL/ALERT_MIN_SEVERITY/RELEASE)
# ---------------------------------------------------------------------------
# Any endpoint that accepts a JSON POST — Sentry, PagerDuty Events, Opsgenie,
# a Slack incoming webhook. There is no SENTRY_DSN variable — this is a
# generic webhook, not a Sentry-specific integration.
ALERT_WEBHOOK_URL=
ALERT_MIN_SEVERITY=warn
# Commit SHA, so an alert can be tied to a deploy.
RELEASE=

# ---------------------------------------------------------------------------
# Rate limiting (§12.1) — api only, all have working defaults
# ---------------------------------------------------------------------------
RATE_LIMIT_MAX=
RATE_LIMIT_WINDOW_MS=
LOGIN_RATE_LIMIT_MAX=
LOGIN_RATE_LIMIT_WINDOW_MS=

# ---------------------------------------------------------------------------
# §0.1's deliberately broken endpoint — api only. Leave both unset/false
# everywhere except a staging environment actively drilling the alert path.
# assertProductionReady refuses to boot with DRILL_ENABLED=true.
# ---------------------------------------------------------------------------
DRILL_ENABLED=false
DRILL_SECRET=
